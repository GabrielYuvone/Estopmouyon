# Cloudflare Pages _headers file for ESTOPMOUYON PWA
# Sirve el manifest y los íconos con el MIME type correcto.

# Manifest JSON
/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

# Service Worker: no cachear nunca (siempre traer la última versión)
/sw.js
  Content-Type: application/javascript
  Cache-Control: no-cache, no-store, must-revalidate

# Íconos PWA (cache largo porque son inmutables)
/icon-192.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/icon-512.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/icon-maskable-512.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable
/favicon-32.png
  Content-Type: image/png
  Cache-Control: public, max-age=31536000, immutable

# HTML principal: revalidar siempre para que el SW detecte cambios
/index.html
  Content-Type: text/html; charset=utf-8
  Cache-Control: no-cache, must-revalidate
